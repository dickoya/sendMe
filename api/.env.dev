# ── SendMe — Variables d'environnement (développement) ──────────────────────
# Ce fichier est chargé automatiquement par Spring Boot (profil "dev").
# NE PAS COMMITTER ce fichier — il contient des secrets.
# Utiliser .env.example comme template pour configurer un nouvel environnement.

# ── Base de données MySQL ───────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/sendme_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=

# ── JWT (JSON Web Token) ────────────────────────────────────────────────────
# Clé secrète pour signer les tokens JWT (minimum 32 caractères recommandé)
JWT_SECRET=une_cle_secrete_longue_min_32_caracteres

# ── Stripe (mode Sandbox) ───────────────────────────────────────────────────
# Clés récupérables depuis https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_VOTRE_CLE_SECRETE_STRIPE
STRIPE_PUBLISHABLE_KEY=pk_test_VOTRE_CLE_PUBLIQUE_STRIPE
STRIPE_WEBHOOK_SECRET=whsec_VOTRE_WEBHOOK_SECRET

# ── OpenExchangeRates (taux de change) ──────────────────────────────────────
# Clé API récupérable depuis https://openexchangerates.org/signup/free
OPENEXCHANGE_APP_ID=VOTRE_APP_ID_OPENEXCHANGE
