# ── SendMe — Variables d'environnement (template) ───────────────────────────
# Copier ce fichier vers .env.dev ou .env.prod et remplir les valeurs.
# NE JAMAIS committer les fichiers .env* contenant de vraies clés.
#
# Usage :
#   cp .env.example .env.dev    # Développement
#   cp .env.example .env.prod   # Production
#
# Ces variables sont lues par Spring Boot via le profil correspondant.

# ── Base de données MySQL ───────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/sendme_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=CHANGEZ_MOI

# ── JWT (JSON Web Token) ────────────────────────────────────────────────────
# Clé secrète pour signer les tokens JWT (minimum 32 caractères recommandé)
# Générer une clé forte avec : openssl rand -base64 64
JWT_SECRET=CHANGEZ_MOI_Par_Une_Cle_Secrete_De_32_Caracteres_Minimum

# ── Stripe (mode Sandbox) ───────────────────────────────────────────────────
# Clés récupérables depuis https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── OpenExchangeRates (taux de change) ──────────────────────────────────────
# Clé API récupérable depuis https://openexchangerates.org/signup/free
OPENEXCHANGE_APP_ID=VotreAppIdIci

# ── CORS (optionnel, valeur par défaut dans application.properties) ─────────
# CORS_ALLOWED_ORIGINS=http://localhost:5173
