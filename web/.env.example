# ── SendMe — Variables d'environnement Frontend (template) ──────────────────
# Copier ce fichier vers .env et remplir les valeurs.
# NE JAMAIS committer le fichier .env contenant de vraies clés.
#
# Usage :
#   cp .env.example .env    # Développement
#
# Ces variables sont accessibles dans le code via import.meta.env.VITE_*

# URL de base de l'API backend (sans slash final)
VITE_API_BASE_URL=http://localhost:8080/api

# Clé publique Stripe (récupérable depuis https://dashboard.stripe.com/test/apikeys)
VITE_STRIPE_PUBLIC_KEY=pk_test_VOTRE_CLE_PUBLIQUE_STRIPE
